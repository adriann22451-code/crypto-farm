# Upstash Redis (Redis > REST API tab on your Upstash database dashboard)
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Telegram bot token from @BotFather (recommended for production — enables
# server-side verification of Telegram initData so nobody can spoof another
# player's identity). App still works without it, using client-supplied ids.
BOT_TOKEN=123456:ABC-your-bot-token

# Random secret string you choose yourself — used to verify that requests to
# /api/telegram-webhook really come from Telegram (set the same value when
# you register the webhook, see README). Any long random string works.
WEBHOOK_SECRET=choose-a-long-random-string

# Protects /api/cron-resolve from being called by randoms. Any long random
# string works — used both by Vercel Cron automatically and by any external
# pinger you set up (see README section 6).
CRON_SECRET=choose-another-long-random-string

# Your bot's @username (no @), used to build the 1-tap "Share Link" referral
# button (t.me/<username>?startapp=<code>). Must start with VITE_ so Vite
# exposes it to the frontend build.
VITE_BOT_USERNAME=your_bot_username

# Your deployed app's URL (no trailing slash) — used for the "Open Crypto
# Farm" button the bot attaches to /start, /balance, /help replies.
MINI_APP_URL=https://your-app.vercel.app
